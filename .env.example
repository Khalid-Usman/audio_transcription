# Copy to .env and adjust. Real environment variables override values in .env.

# PostgreSQL connection (job state and transcription results)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcriptions

# Whisper model: tiny | base | small | medium | large-v3 | turbo | path to a local CTranslate2 model
WHISPER_MODEL=small
# auto = NVIDIA GPU if usable, otherwise CPU | cpu | cuda  (Apple Silicon always uses the CPU)
WHISPER_DEVICE=auto
# auto = float16 on GPU, int8 on CPU | int8 | int8_float16 | int8_float32 | float16 | float32 ...
WHISPER_COMPUTE_TYPE=auto
# CPU threads per transcription; 0 = CTranslate2 default
WHISPER_CPU_THREADS=0
WHISPER_BEAM_SIZE=5
# Skip silence with Silero VAD (recommended, especially for long recordings)
WHISPER_VAD_FILTER=true
# Where models are downloaded on first use
MODEL_DOWNLOAD_DIR=models

# Transcriptions running at the same time (each uses CPU threads or GPU memory)
MAX_CONCURRENT_TRANSCRIPTIONS=1
# Queued + running jobs before new uploads get HTTP 503
MAX_PENDING_JOBS=20

# Recordings up to this length return the transcription directly...
SYNC_MAX_DURATION_SECONDS=30
# ...unless it takes longer than this; then the response is 202 with a job ID
SYNC_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=500
# 3 hours. Decoded audio needs about 230 MB of RAM per hour.
MAX_AUDIO_DURATION_SECONDS=10800

# Uploaded audio is stored in DATA_DIR/audio
DATA_DIR=data
LOG_LEVEL=INFO